{
  "name": "archestraide",
  "version": "0.1.0",
  "private": true,
  "description": "Retrieval-based support assistant for AVEVA Application Server and OMI",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "build:static": "node scripts/build-static.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/tests/*.test.js"
  },
  "dependencies": {
    "next": "15.5.26",
    "pdfjs-dist": "^4.7.76",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.19",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.6",
    "typescript": "5.5.3"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss"
    }
  }
}
